{
    "name": "aaieduhr/heartphrame-module-workspace-search",
    "description": "ACL-aware Workspace search module for HeartPhrame",
    "type": "heartphrame-module",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "EUPL-1.2",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-menu.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-workspace.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aaieduhr/heartphrame-framework": "dev-main",
        "aaieduhr/heartphrame-module-auth": "dev-main",
        "aaieduhr/heartphrame-module-editor-html": "dev-main",
        "aaieduhr/heartphrame-module-menu": "dev-main",
        "aaieduhr/heartphrame-module-orm": "dev-main",
        "aaieduhr/heartphrame-module-workspace": "dev-main"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-backup": "Rebuilds the derived ACL-aware search index after a successful restore instead of archiving it.",
        "aaieduhr/heartphrame-module-api": "Exposes ACL-aware Workspace searches through /api/v1/workspace-search."
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleWorkspaceSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleWorkspaceSearch\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kresimir Mihalj"
        }
    ],
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    }
}
